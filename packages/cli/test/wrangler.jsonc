{
  "name": "boxox-cli-test", "main": "worker.ts", "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "boxox-cli-test", "database_id": "local-test" }],
  "r2_buckets": [{ "binding": "MAIL_STORE", "bucket_name": "boxox-cli-test" }],
  "durable_objects": { "bindings": [{ "name": "MAILBOX_HUB", "class_name": "MailboxHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxHub"] }]
}
