{
  "name": "@boxox/cli",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "Manage Box Ox developer email from the terminal",
  "bin": {
    "boxox": "dist/boxox.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "pnpm --filter @boxox/mail build && tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@boxox/db": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.4",
    "hono": "^4.13.13",
    "typescript": "^5.9.3",
    "@boxox/mail": "workspace:*",
    "ws": "^8.18.3"
  },
  "private": true
}
