{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boxox",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "CF_ACCOUNT_ID": "",
    "OWNER_EMAIL": "",
    "BOXOX_EDITION": "free"
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boxox",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_STORE",
      "bucket_name": "boxox-mail"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "webhook-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "webhook-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "webhook-delivery-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "boxox-ingest",
      "binding": "INGEST_WORKFLOW",
      "class_name": "IngestWorkflow"
    },
    {
      "name": "boxox-enrich",
      "binding": "ENRICH_WORKFLOW",
      "class_name": "EnrichWorkflow"
    },
    {
      "name": "boxox-snooze",
      "binding": "SNOOZE_WORKFLOW",
      "class_name": "SnoozeWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAILBOX_HUB",
        "class_name": "MailboxHub"
      },
      {
        "name": "FREE_RUNTIME",
        "class_name": "FreeRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MailboxHub"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "FreeRuntime"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "INBOUND_GLOBAL_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "INBOUND_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AGENT_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *",
      "0 */6 * * *",
      "15 * * * *",
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
